# =====================================================
# KisanQ Backend — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit your real .env file.
# =====================================================

PORT=5000

# ---------- MySQL ----------
# Any MySQL 8+ instance (local, PlanetScale, Railway, etc.)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kisanq

# ---------- Twilio ----------
# Console: https://console.twilio.com
# Account SID + Auth Token are on the console dashboard home page.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Create a Verify Service (used for OTP send/check) at:
# Console > Verify > Services > Create new Service
TWILIO_VERIFY_SERVICE_SID=

# A Twilio phone number you own, used for status-update SMS
# (booked / called / procured / paid). Buy one under
# Console > Phone Numbers > Manage > Buy a number.
TWILIO_PHONE_NUMBER=

# NOTE (trial accounts): a Twilio trial account can only send
# OTP/SMS to phone numbers you've manually verified in the
# console (Console > Verify > Verified Caller IDs). Upgrade to
# a paid account to message any number.

# ---------- Razorpay ----------
# Dashboard: https://dashboard.razorpay.com/app/keys
# Use the "Test Mode" keys while developing — they work
# end-to-end with test cards/UPI, no real money moves.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------- Google (server-side; separate from the browser key) ----------
# Google Cloud Console > APIs & Services > Credentials.
# Create a SEPARATE key from the one in index.html, restrict it
# by server IP (not HTTP referrer), and enable:
#   - Geocoding API
#   - Places API
GOOGLE_SERVER_KEY=

# ---------- Admin login (prototype-grade, no user table) ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---------- CORS ----------
# Comma-separated list of origins allowed to call this API
# (your frontend's URL while developing / after deploy).
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
